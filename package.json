    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8"
