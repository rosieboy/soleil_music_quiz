# Local development. Copy to .env and generate a private secret:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:4321
TURSO_DATABASE_URL=file:.astro/content.db
TURSO_AUTH_TOKEN=

# Netlify production: use your OWN Turso database URL and token instead.
# Set BETTER_AUTH_URL and PUBLIC_APP_URL to your https://...netlify.app address.
# Set all five values in the Netlify UI, never in a committed file.
